# Zirplus contracts: Robinhood Chain mainnet (chain ID 4663).
# Load before running forge:  source .env

# Deployer key. While GOV / GUARDIAN / ATTESTATION_ISSUER are empty, this account is all three.
PRIVATE_KEY=

# RPC and verification (docs.robinhood.com/chain). The public RPC is rate-limited; for heavy use switch to
# https://robinhood-mainnet.g.alchemy.com/v2/<key>.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api/
BLOCKSCOUT_API_KEY=unused

# Governance. Empty = the deployer. Set GOV to a multisig later via ParamController.transferOwnership.
GOV=
GUARDIAN=
ATTESTATION_ISSUER=
# Deployer attests itself for TRADER / LP / MAKER / RELAYER when it is the issuer.
SELF_ATTEST=true
# 48h timelock on every parameter change once bootstrap finishes (minimum 1h, maximum 30 days).
TIMELOCK_DELAY=172800
FINISH_BOOTSTRAP=true

# External dependencies, checked on-chain 2026-10-14.
# USDG: docs.robinhood.com/chain/contracts (6 decimals)
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# NVDA Stock Token: api.robinhood.com/rhj/assets (18 decimals, uiMultiplier + oraclePaused)
STOCK_TOKEN=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# Chainlink "Robinhood NVDA / USD" proxy (8 decimals, 24h heartbeat, 0.5% deviation)
STOCK_FEED=0x379EC4f7C378F34a1B47E4F3cbeBCbAC3E8E9F15
# Chainlink L2 Sequencer Uptime Feed: not published for Robinhood Chain yet. Empty skips the guard; set it
# later with OracleRouter.setSequencerFeed once it appears at docs.chain.link/data-feeds/l2-sequencer-feeds.
SEQUENCER_FEED=
# Must stay empty: Stock Tokens have no marketStatus(), so the weekday schedule is used instead.
MARKET_STATUS_SOURCE=
STREAM_ADAPTER=

# Staleness bounds in seconds, just above the feed's 24h heartbeat (4 days covers a long weekend).
STALENESS_REGULAR=90000
STALENESS_EXTENDED=90000
STALENESS_CLOSED=345600
