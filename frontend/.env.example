# --- Privy (authentication) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Supabase (data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key from Project Settings > API keys (the "service_role" or "sb_secret_" key).
# Server-side only; never exposed to the browser. The anon key here will make every write fail.
SUPABASE_SERVICE_ROLE_KEY=

# --- Robinhood Chain ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_CHAIN_EXPLORER=https://robinhoodchain.blockscout.com

# --- Site and community (optional; empty values hide the matching links) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Your $ZIRPLUS token, if you launch one. Shown on the homepage only when set.
NEXT_PUBLIC_ZIRPLUS_TOKEN_ADDRESS=

# --- Self-certified attestation (POST /api/platform/attest) ---
# Server-only key of a DEDICATED issuer wallet (never the deployer key). Add it on-chain first with
# contracts/script/add-issuer.sh (48h timelock), and keep a little ETH on it for gas.
ATTESTER_PRIVATE_KEY=
# ISO country codes refused, on both the declared and the network country. Default: US,CU,IR,KP,SY,RU,BY.
ATTEST_BLOCKED_COUNTRIES=
# Optional allow-list; when set, only these countries can self-certify.
ATTEST_ALLOWED_COUNTRIES=
# Attestation lifetime in days.
ATTEST_TTL_DAYS=180
