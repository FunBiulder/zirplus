# --- Privy (authentication) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Supabase (data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key from Project Settings > API keys (the "service_role" or "sb_secret_" key).
# Server-side only; never exposed to the browser. The anon key here will make every write fail.
SUPABASE_SERVICE_ROLE_KEY=

# --- Robinhood Chain ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_CHAIN_EXPLORER=https://robinhoodchain.blockscout.com

# --- Site and community (optional; empty values hide the matching links) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Your $ZIRPLUS token, if you launch one. Shown on the homepage only when set.
NEXT_PUBLIC_ZIRPLUS_TOKEN_ADDRESS=
